{
  "name": "formpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:app": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "npm run clean && npm run typecheck && npm run build:app && npm run build:content",
    "dev": "npm run clean && concurrently -n app,content \"vite build --watch\" \"vite build --config vite.content.config.ts --watch\"",
    "test-forms": "vite test-forms --port 5500 --strictPort"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
